{
  "name": "radar",
  "version": "1.0.0",
  "description": "Doc tin, loc theo thoi diem, trich pain point, goi y san pham",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:team": "node build-team.js"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.radar.app",
    "productName": "Radar",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "team/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "Radar-${version}-mac.${ext}",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Radar-${version}-win.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "directories": {
      "buildResources": "build"
    }
  },
  "author": "Radar"
}